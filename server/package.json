    "helmet": "^6.0.1",
    "ajv": "^8.12.0",
    "groq-sdk": "^0.30.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "nodemonConfig": {
    "ext": "js,json",
    "ignore": [
