# GitHub Personal Access Token (optional but strongly recommended to avoid rate limiting)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only for public repos is fine)
GITHUB_TOKEN=

# Google Gemini API Key
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Server port
PORT=5000

# Optional: Node environment
NODE_ENV=development
