# GitHub Personal Access Token (optional but strongly recommended to avoid rate limiting)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only for public repos is fine)
GITHUB_TOKEN=

# Groq API Key
# Get at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Server port
PORT=5000

# Optional: Node environment
NODE_ENV=development
